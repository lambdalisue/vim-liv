#!/usr/bin/env luajit
-- liv-generator — regenerate the typed, version-pinned editor bindings from
-- Vim/Neovim docs (the liv.generator dev tool; à la @denops/std's gen scripts).
-- Downloads each editor's runtime/doc at the pinned versions, parses, and writes
-- the committed generated files. Run from anywhere:  /path/to/vim-liv/bin/liv-generator
local here = arg[0]:match("^(.*)/[^/]+$") or "."
local root = io.popen("cd '" .. here .. "/..' && pwd"):read("*l")
package.path = root .. "/lua/?.lua;" .. root .. "/lua/?/init.lua;" .. package.path

local versions = require("liv.generator.supported_versions")
local opt_parse = require("liv.generator.option.parse")
local opt_generate = require("liv.generator.option.generate")
local fn_parse = require("liv.generator.function.parse")
local fn_generate = require("liv.generator.function.generate")

local function download(url)
  local pipe = io.popen("curl -fsSL '" .. url .. "'")
  local body = pipe:read("*a")
  local ok = pipe:close()
  if not ok or body == "" then
    error("download failed: " .. url)
  end
  return body
end

local function doc_url(host, version, file)
  return string.format("https://raw.githubusercontent.com/%s/v%s/runtime/doc/%s", host, version, file)
end

io.write(string.format("liv-generator: vim %s, neovim %s\n", versions.vim, versions.neovim))

local function write_all(files)
  for relpath, content in pairs(files) do
    local path = root .. "/" .. relpath
    os.execute("mkdir -p '" .. path:match("^(.*)/[^/]+$") .. "'")
    local f = assert(io.open(path, "w"))
    f:write(content)
    f:close()
    io.write("  wrote " .. relpath .. "\n")
  end
end

io.write("downloading options.txt ...\n")
local vim_opts = opt_parse(download(doc_url("vim/vim", versions.vim, "options.txt")))
local nvim_opts = opt_parse(download(doc_url("neovim/neovim", versions.neovim, "options.txt")))
io.write(string.format("  parsed: vim=%d, neovim=%d options\n", #vim_opts, #nvim_opts))
write_all(opt_generate(vim_opts, nvim_opts))

io.write("downloading builtin.txt ...\n")
local vim_fns = fn_parse(download(doc_url("vim/vim", versions.vim, "builtin.txt")))
local nvim_fns = fn_parse(download(doc_url("neovim/neovim", versions.neovim, "builtin.txt")))
io.write(string.format("  parsed: vim=%d, neovim=%d functions\n", #vim_fns, #nvim_fns))
write_all(fn_generate(vim_fns, nvim_fns))

io.write("done\n")
